<main class="page-shell narrow-shell">
  <p class="notice"><%= notice %></p>

  <header class="page-header">
    <p class="eyebrow">Movie details</p>
    <h1><%= @movie.title %></h1>
  </header>

  <section class="movie-card">
    <%= render @movie %>
  </section>

  <nav class="action-bar">
    <%= link_to "Edit movie", edit_movie_path(@movie, sorting_query), class: "button button-primary" %>
    <%= link_to "Back to movies", movies_path(sorting_query), class: "button button-secondary" %>
    <%= button_to "Delete movie", @movie, method: :delete, class: "button button-danger" %>
  </nav>
</main>
