<main class="page-shell narrow-shell">
  <% content_for :title, "Editing movie" %>

  <header class="page-header">
    <p class="eyebrow">Keep it fresh</p>
    <h1>Editing movie</h1>
    <p class="page-intro">Update the details for this movie.</p>
  </header>

  <section class="form-card">
    <%= render "form", movie: @movie %>
  </section>

  <nav class="action-bar">
    <%= link_to "Show movie", movie_path(@movie, sorting_query), class: "button button-primary" %>
    <%= link_to "Back to movies", movies_path(sorting_query), class: "button button-secondary" %>
  </nav>
</main>
