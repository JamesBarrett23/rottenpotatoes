<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Rating</th>
      <th>Release date</th>
    </tr>
  </thead>
  <tbody id="movies">
    <% @movies.each do |movie| %>
      <tr id="<%= dom_id movie %>">
        <td><%= link_to movie.title, movie %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <th colspan="3"><%= @movies.size %> total movies</th>
    </tr>
  </tfoot>
</table>

<%= link_to "New movie", new_movie_path %>
