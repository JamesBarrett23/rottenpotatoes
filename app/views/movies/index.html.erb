<main class="page-shell">
  <p class="notice"><%= notice %></p>

  <% content_for :title, "Movies" %>

  <header class="page-header">
    <p class="eyebrow">Movie list</p>
    <h1>Movies</h1>
    <p class="page-intro">Browse the movies and sort it by title, rating, or release date by clicking on the column headers.</p>
  </header>

  <section class="table-card">
    <table>
      <thead>
        <tr>
          <th class="<%= sort_column_class("title") %>"><%= sortable_column_link("Title", "title") %></th>
          <th class="<%= sort_column_class("rating") %>"><%= sortable_column_link("Rating", "rating") %></th>
          <th class="<%= sort_column_class("release_date") %>"><%= sortable_column_link("Release date", "release_date") %></th>
        </tr>
      </thead>
      <tbody id="movies">
        <% @movies.each do |movie| %>
          <tr id="<%= dom_id movie %>">
            <td><%= link_to movie.title, movie %></td>
            <td><%= movie.rating %></td>
            <td><%= movie.release_date %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="3"><%= @movies.size %> total movies</th>
        </tr>
      </tfoot>
    </table>
  </section>

  <nav class="action-bar">
    <%= link_to "Add a movie", new_movie_path(sorting_query), class: "button button-primary" %>
  </nav>
</main>
